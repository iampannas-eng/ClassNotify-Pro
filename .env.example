# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (ห้าม commit .env)

# --- PostgreSQL (ใช้โดย docker-compose) ---
POSTGRES_USER=classnotify
POSTGRES_PASSWORD=เปลี่ยนเป็นรหัสผ่านยาวๆ
POSTGRES_DB=classnotify

# --- Flask app ---
# ใน Docker ให้ชี้ไปที่ service ชื่อ db (ไม่ใช่ localhost)
DATABASE_URL=postgresql://classnotify:เปลี่ยนเป็นรหัสผ่านยาวๆ@db:5432/classnotify
SECRET_KEY=สุ่มด้วย: python -c "import secrets; print(secrets.token_hex(32))"

# --- LINE Messaging API ---
LINE_ACCESS_TOKEN=
LINE_USER_ID=

# --- Cloudflare Tunnel ---
# ได้จาก Cloudflare Zero Trust > Networks > Tunnels > Create tunnel (เลือก Docker) จะเห็น token ยาวๆ
TUNNEL_TOKEN=

# --- ส่งออกข้อมูลให้จอทีวี (scripts/export_today.py) ---
# token จาก GitHub > Settings > Developer settings > Personal access tokens (classic) scope: gist
GIST_TOKEN=
# ปล่อยว่างได้ สคริปต์จะสร้าง Gist ให้เองครั้งแรกและจำ id ไว้ใน export/gist_id.txt
GIST_ID=
